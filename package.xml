<?xml version="1.0"?>
<?xml-model
   href="http://download.ros.org/schema/package_format3.xsd"
   schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arena_swerve_controller</name>
  <version>0.1.0</version>
  <description>
    ros2_control plugin for 4-wheel independent steering (swerve drive)
    chassis. Maps a Twist (vx, vy, wz) reference to per-wheel velocity and
    per-steering position commands, and publishes odometry derived from the
    measured wheel velocity / steering position state.
  </description>
  <maintainer email="dev@voshch.dev">Volodymyr Shcherbyna</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/arena-robots/arena_swerve_controller</url>
  <url type="repository">https://github.com/arena-robots/arena_swerve_controller</url>
  <url type="bugtracker">https://github.com/arena-robots/arena_swerve_controller/issues</url>

  <author email="dev@voshch.dev">Volodymyr Shcherbyna</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>eigen</depend>
  <depend>generate_parameter_library</depend>
  <depend>geometry_msgs</depend>
  <depend>hardware_interface</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>

  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
